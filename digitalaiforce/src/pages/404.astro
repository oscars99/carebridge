---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { services, serviceUrl } from '../data/services';
---

<BaseLayout
  title="Page Not Found | Digital AI Force"
  description="Sorry, we couldn’t find that page. Explore our services or head back home."
  noindex
>
  <section class="nf" aria-labelledby="nf-title">
    <div class="bg-grid nf__grid" aria-hidden="true"></div>
    <div class="container nf__inner">
      <p class="nf__code enter" aria-hidden="true">4<em>0</em>4</p>
      <h1 id="nf-title" data-split>This page took a <span class="text-gradient">wrong turn</span></h1>
      <p class="lead enter" style="--d: 2">
        The page you’re looking for may have moved or no longer exists. Let’s get you back on track.
      </p>
      <div class="btn-row nf__actions enter" style="--d: 3">
        <a href="/" class="btn btn--primary btn--lg">Back to home <Icon name="arrow-right" class="icon--move" /></a>
        <a href="/contact/" class="btn btn--ghost btn--lg">Contact us</a>
      </div>
      <nav class="nf__links enter" style="--d: 4" aria-label="Popular pages">
        <p>Popular pages</p>
        <ul role="list">
          {
            services.slice(0, 6).map((s) => (
              <li>
                <a href={serviceUrl(s.slug)}>
                  <Icon name={s.icon} size={18} />
                  {s.navLabel}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/pricing/"><Icon name="badge-dollar-sign" size={18} />Pricing</a>
          </li>
          <li>
            <a href="/blog/"><Icon name="book-open" size={18} />Blog</a>
          </li>
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    position: relative;
    overflow: clip;
    isolation: isolate;
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    align-items: center;
    padding: calc(var(--header-h) + 48px) 0 80px;
    text-align: center;
  }

  .nf__grid {
    z-index: -1;
  }

  .nf__inner {
    max-width: 960px;
  }

  .nf__code {
    font-family: var(--font-display);
    font-size: clamp(8rem, 30vw, 20rem);
    line-height: 0.8;
    letter-spacing: -0.05em;
    color: var(--ink);
  }

  .nf__code em {
    color: var(--ember-ink);
  }

  .nf h1 {
    margin-top: 24px;
    font-size: clamp(2.4rem, 5.4vw, 4.6rem);
  }

  .nf .lead {
    margin: 22px auto 0;
  }

  .nf__actions {
    justify-content: center;
    margin-top: 36px;
  }

  .nf__links {
    margin-top: 56px;
  }

  .nf__links p {
    margin-bottom: 14px;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .nf__links ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 0;
    padding: 0;
  }

  .nf__links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 0.94rem;
    color: var(--ink);
    border: 1px solid var(--line-strong);
    transition:
      color var(--dur) ease,
      border-color var(--dur) ease,
      background-color var(--dur) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .nf__links a:hover {
      color: var(--paper);
      background: var(--ink);
      border-color: var(--ink);
    }
  }
</style>
