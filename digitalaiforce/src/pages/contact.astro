---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import FAQ from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import { breadcrumbNode, faqNode } from '../lib/schema';

const path = '/contact/';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path },
];

const nextSteps = [
  { title: 'We review your message', text: `A real person reads every inquiry and replies ${site.responseTime}.` },
  { title: 'Free strategy call', text: 'A relaxed 30-minute call to understand your goals, plus a quick look at your current setup.' },
  { title: 'Clear plan & fixed quote', text: 'You get honest recommendations and a written quote. No pressure, no obligation.' },
];

const faqs = [
  {
    q: 'Is the strategy call really free?',
    a: 'Yes — completely free and with no obligation. You’ll walk away with practical ideas you can use whether or not you decide to work with us.',
  },
  {
    q: 'Do I need to know exactly what I want?',
    a: 'Not at all. Tell us about your business and goals, and we’ll recommend the few services that will make the biggest difference.',
  },
  {
    q: 'What should I prepare before our call?',
    a: 'Nothing formal. It helps to have your website address (if you have one), a rough idea of your budget and timeline, and a few competitors or sites you like.',
  },
];
---

<BaseLayout
  title="Contact Us — Get a Free Quote | Digital AI Force"
  description="Tell us about your business and goals. Get a free strategy call and a fixed, written quote for your website, SEO, marketing, app or AI project."
  pageType="ContactPage"
  schema={[breadcrumbNode(path, crumbs), faqNode(path, faqs)]}
>
  <PageHero
    eyebrow="Contact"
    title="Let’s grow your business"
    accent="together"
    intro={`Tell us a little about your business and what you’d like to achieve. We’ll reply ${site.responseTime} with next steps — usually a free strategy call.`}
    crumbs={crumbs}
  />

  <section class="section contact-page" aria-labelledby="form-title">
    <div class="container contact-page__grid">
      <div class="contact-page__form card" data-reveal="scale">
        <h2 id="form-title" class="contact-page__title">Request your free quote</h2>
        <p class="contact-page__sub">Fields marked <span aria-hidden="true">*</span><span class="sr-only">with an asterisk</span> are required.</p>
        <ContactForm id="contact" />
      </div>

      <aside class="contact-page__aside" aria-label="What to expect">
        <div class="card next" data-reveal style="--i: 1">
          <h2 class="next__title">What happens next</h2>
          <ol class="next__list" role="list">
            {
              nextSteps.map((step, i) => (
                <li>
                  <span class="next__num" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <div>
                    <h3>{step.title}</h3>
                    <p>{step.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="card direct theme-dark" data-reveal style="--i: 2">
          <h2 class="next__title">Prefer email?</h2>
          <a href={`mailto:${site.email}`} class="direct__link">
            <Icon name="mail" size={20} />
            {site.email}
          </a>
          {
            site.phone && (
              <a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`} class="direct__link">
                <Icon name="phone" size={20} />
                {site.phone}
              </a>
            )
          }
          {
            site.location && (
              <p class="direct__link">
                <Icon name="map-pin" size={20} />
                {site.location}
              </p>
            )
          }
          <p class="direct__note">
            <Icon name="clock" size={18} /> We reply {site.responseTime}.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section theme-white" aria-labelledby="contact-faq-title">
    <div class="container container--narrow">
      <div class="section-head section-head--center" data-reveal>
        <p class="eyebrow">Before you reach out</p>
        <h2 id="contact-faq-title" data-split>Quick <span class="text-gradient">answers</span></h2>
      </div>
      <FAQ faqs={faqs} />
    </div>
  </section>
</BaseLayout>

<style>
  .contact-page {
    padding-top: clamp(56px, 7vw, 96px);
  }

  .contact-page__grid {
    display: grid;
    gap: 24px;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .contact-page__grid {
      grid-template-columns: 1.5fr 1fr;
      gap: 40px;
    }

    .contact-page__aside {
      position: sticky;
      top: calc(var(--header-h) + 24px);
    }
  }

  .contact-page__form {
    padding: clamp(24px, 4vw, 52px);
    border-radius: var(--radius-xl);
  }

  .contact-page__title {
    font-size: clamp(2.2rem, 4vw, 3.4rem);
  }

  .contact-page__sub {
    margin: 12px 0 34px;
    font-size: 0.95rem;
  }

  .contact-page__sub span[aria-hidden] {
    color: var(--ember-ink);
  }

  .contact-page__aside {
    display: grid;
    gap: 20px;
  }

  .next__title {
    margin-bottom: 18px;
    font-size: 2rem;
  }

  .next__list {
    display: grid;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .next__list li {
    display: flex;
    gap: 14px;
    align-items: baseline;
    padding-block: 16px;
    border-bottom: 1px solid var(--line);
  }

  .next__list li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .next__list h3 {
    font-size: 1.02rem;
    margin-bottom: 2px;
  }

  .next__list p {
    font-size: 0.95rem;
  }

  .next__num {
    flex: none;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--ember-ink);
  }

  .contact-page .direct {
    display: grid;
    gap: 14px;
    background: var(--ink);
    border-color: var(--ink);
  }

  .direct .next__title {
    margin-bottom: 4px;
  }

  .direct .direct__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 500;
    font-size: 1.1rem;
    color: var(--on-dark);
    overflow-wrap: anywhere;
  }

  .direct a.direct__link:hover {
    color: var(--ember);
  }

  .direct__link :global(.icon),
  .direct__note :global(.icon) {
    flex: none;
    color: var(--ember);
  }

  .direct__note {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.92rem;
  }
</style>
