---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import FAQ from '../../components/FAQ.astro';
import CTABand from '../../components/CTABand.astro';
import Icon from '../../components/Icon.astro';
import { services, serviceUrl, getService, type Service } from '../../data/services';
import { breadcrumbNode, faqNode, serviceNode } from '../../lib/schema';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
const path = serviceUrl(service.slug);
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
  { name: service.name, path },
];
const related = service.related.map((slug) => getService(slug)).filter((s): s is Service => Boolean(s));
const quoteHref = `/contact/?service=${service.slug}`;
---

<BaseLayout
  title={service.seo.title}
  description={service.seo.description}
  schema={[serviceNode(service.slug), breadcrumbNode(path, crumbs), faqNode(path, service.faqs)]}
>
  <PageHero eyebrow={service.hero.eyebrow} title={service.hero.title} accent={service.hero.accent} intro={service.hero.intro} crumbs={crumbs}>
    <div class="btn-row svc-hero__ctas enter" style="--d: 4">
      <a href={quoteHref} class="btn btn--primary btn--lg">Get a free quote <Icon name="arrow-right" class="icon--move" /></a>
      <a href="/pricing/" class="btn btn--ghost btn--lg">See pricing</a>
    </div>

    <aside slot="aside" class="svc-card enter" style="--d: 3" aria-label={`${service.name} at a glance`}>
      <div class="svc-card__top">
        <p class="svc-card__label">At a glance</p>
        <span class="svc-card__icon"><Icon name={service.icon} size={26} strokeWidth={1.5} /></span>
      </div>
      <ul class="svc-card__list" role="list">
        {
          service.hero.bullets.map((b, i) => (
            <li>
              <span class="svc-card__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span>{b}</span>
            </li>
          ))
        }
      </ul>
      <p class="svc-card__price">{service.pricingNote}</p>
    </aside>
  </PageHero>

  <section class="section" aria-labelledby="overview-title">
    <div class="container split split--60-40 split--top">
      <div class="svc-overview" data-reveal>
        <p class="eyebrow">Why it matters</p>
        <h2 id="overview-title" data-split>{service.overview.heading}</h2>
        {service.overview.paragraphs.map((p) => <p class="svc-overview__p">{p}</p>)}
        <ul class="chip-row mt-3" role="list" aria-label="Focus areas">
          {service.highlights.map((h) => <li class="chip">{h}</li>)}
        </ul>
      </div>
      <div class="svc-included card" data-reveal="scale">
        <h3>What’s included</h3>
        <ul class="check-list" role="list">
          {service.deliverables.map((d) => <li>{d}</li>)}
        </ul>
        <a href={quoteHref} class="btn btn--primary btn--block mt-3">Get my free quote <Icon name="arrow-right" class="icon--move" /></a>
      </div>
    </div>
  </section>

  <section class="section theme-white" aria-labelledby="features-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div data-reveal>
          <p class="eyebrow">Features</p>
          <h2 id="features-title" data-split>
            {service.name}, <span class="text-gradient">done right</span>
          </h2>
        </div>
        <p class="lead" data-reveal style="--i: 1">Everything you need to see real results — planned, built and managed by one accountable team.</p>
      </div>
      <ul class="ruled-grid ruled-grid--3" role="list">
        {
          service.features.map((f, i) => (
            <li data-reveal style={`--i: ${i % 3}`}>
              <div class="ruled__top">
                <span class="ruled__num">{String(i + 1).padStart(2, '0')}</span>
                <Icon name={f.icon} />
              </div>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="process-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div data-reveal>
          <p class="eyebrow">Our process</p>
          <h2 id="process-title" data-split>{service.name}: <span class="text-gradient">how it works</span></h2>
        </div>
        <p class="lead" data-reveal style="--i: 1">A clear, collaborative process — so you always know what’s happening and what comes next.</p>
      </div>
      <ProcessSteps steps={service.process} />
    </div>
  </section>

  <section class="section theme-white" aria-labelledby="faq-title">
    <div class="container split split--40-60 split--top">
      <div class="section-head svc-faq-intro" data-reveal>
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-title" data-split>{service.name} <span class="text-gradient">questions</span></h2>
        <p class="lead">Straight answers to what small business owners ask us most. Don’t see yours?</p>
        <a href={quoteHref} class="link-arrow mt-3">Ask us directly <Icon name="arrow-right" /></a>
      </div>
      <FAQ faqs={service.faqs} />
    </div>
  </section>

  <section class="section" aria-labelledby="related-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div data-reveal>
          <p class="eyebrow">Pairs well with</p>
          <h2 id="related-title" data-split>Grow faster with <span class="text-gradient">related services</span></h2>
        </div>
        <a href="/services/" class="link-arrow" data-reveal>View all services <Icon name="arrow-right" /></a>
      </div>
      <div class="grid grid-3">
        {
          related.map((r, i) => (
            <article class="card lift related" data-reveal style={`--i: ${i}`}>
              <div class="related__top">
                <span class="related__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <Icon name={r.icon} />
              </div>
              <h3>
                <a href={serviceUrl(r.slug)} class="stretched-link">
                  {r.name}
                </a>
              </h3>
              <p>{r.summary}</p>
              <span class="link-arrow related__more" aria-hidden="true">
                Learn more <Icon name="arrow-right" />
              </span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CTABand
    title="Ready to get started with"
    accent={`${service.name}?`}
    text="Get a free strategy call and a fixed, written quote. No pressure, no jargon — just a clear plan to grow your business."
    primaryHref={quoteHref}
    primaryLabel="Get a free quote"
  />
</BaseLayout>

<style>
  .svc-hero__ctas {
    margin-top: 36px;
  }

  /* ---------- At-a-glance card ---------- */
  .svc-card {
    display: grid;
    gap: 20px;
    padding: clamp(24px, 3vw, 34px);
    border-radius: var(--radius-xl);
    color: var(--on-dark);
    background: var(--ink);
  }

  .svc-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .svc-card__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    color: var(--ink);
    background: var(--ember);
  }

  .svc-card__label {
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-dark-2);
  }

  .svc-card__list {
    display: grid;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--dark-line);
  }

  .svc-card__list li {
    display: flex;
    gap: 14px;
    align-items: baseline;
    padding-block: 14px;
    border-bottom: 1px solid var(--dark-line);
  }

  .svc-card__n {
    flex: none;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--ember);
  }

  .svc-card__price {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.15;
    color: var(--on-dark);
  }

  /* ---------- Overview ---------- */
  .svc-overview h2 {
    margin-bottom: 28px;
  }

  .svc-overview__p {
    margin-top: 1rem;
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 62ch;
  }

  .svc-included {
    display: grid;
    gap: 22px;
    padding: clamp(26px, 3vw, 38px);
  }

  .svc-included h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 2rem;
    line-height: 1;
    margin: 0;
  }

  .svc-faq-intro {
    margin-bottom: 0;
  }

  @media (min-width: 960px) {
    .svc-faq-intro {
      position: sticky;
      top: calc(var(--header-h) + 32px);
    }
  }

  /* ---------- Related ---------- */
  .related {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .related__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .related__n {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--ember-ink);
  }

  .related h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.7rem, 2.4vw, 2.1rem);
    line-height: 1.02;
    margin: 0;
  }

  .related h3 a:focus-visible {
    outline: none;
  }

  .related:has(.stretched-link:focus-visible) {
    outline: 2px solid var(--ember-ink);
    outline-offset: 3px;
  }

  .related__more {
    margin-top: auto;
    align-self: flex-start;
  }
</style>
