---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTABand from '../components/CTABand.astro';
import Icon from '../components/Icon.astro';
import { breadcrumbNode } from '../lib/schema';

const path = '/about/';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'About', path },
];

const values = [
  {
    icon: 'message-square',
    title: 'Clarity over jargon',
    text: 'We explain what we’re doing and why in plain English, so you can make confident decisions.',
  },
  {
    icon: 'target',
    title: 'Results you can measure',
    text: 'We focus on calls, leads, bookings and sales — and report on them honestly every month.',
  },
  {
    icon: 'handshake',
    title: 'Partnership, not lock-in',
    text: 'No long-term contracts and no hostage situations. You own everything we build for you.',
  },
  {
    icon: 'shield-check',
    title: 'Responsible AI',
    text: 'AI makes us faster, but people make the decisions. Every deliverable is reviewed by an expert.',
  },
];

const aiSplit = [
  {
    icon: 'cpu',
    title: 'AI handles the heavy lifting',
    points: ['Research & competitor analysis', 'First drafts & content variations', 'Testing, QA & reporting', 'Automations that run 24/7'],
  },
  {
    icon: 'users',
    title: 'People make it great',
    points: ['Strategy & positioning', 'Design & brand judgment', 'Final review of everything', 'Relationships & support'],
  },
  {
    icon: 'lock',
    title: 'Your data stays protected',
    points: ['Business-grade AI tools only', 'No sensitive data without consent', 'Clear, documented data flows', 'You own your accounts'],
  },
];

type Mark = 'yes' | 'no' | 'varies';
const compare: { label: string; us: Mark; agency: Mark; diy: Mark }[] = [
  { label: 'Custom strategy for your business', us: 'yes', agency: 'yes', diy: 'no' },
  { label: 'Expert design, copy & SEO', us: 'yes', agency: 'yes', diy: 'no' },
  { label: 'Launch in weeks, not months', us: 'yes', agency: 'varies', diy: 'yes' },
  { label: 'Transparent, fixed pricing', us: 'yes', agency: 'varies', diy: 'yes' },
  { label: 'No long-term contracts', us: 'yes', agency: 'no', diy: 'yes' },
  { label: 'Website, SEO, ads & AI under one roof', us: 'yes', agency: 'varies', diy: 'no' },
  { label: 'You own your site, content & accounts', us: 'yes', agency: 'varies', diy: 'varies' },
];
---

<BaseLayout
  title="About Digital AI Force — AI-Powered, Human-Led Digital Agency"
  description="Digital AI Force helps small businesses grow with websites, SEO, marketing, apps and AI automation. Learn about our mission, values and how we use AI responsibly."
  pageType="AboutPage"
  schema={[breadcrumbNode(path, crumbs)]}
>
  <PageHero
    eyebrow="About us"
    title="The digital team small businesses"
    accent="deserve"
    intro="Digital AI Force was built on a simple idea: small businesses deserve the same digital firepower as big brands — without the big-agency price tag, jargon or long contracts."
    crumbs={crumbs}
    size="large"
  />

  <section class="section" aria-labelledby="mission-title">
    <div class="container split split--top">
      <div data-reveal>
        <p class="eyebrow">Our mission</p>
        <h2 id="mission-title">Make modern digital growth <span class="text-gradient">simple, affordable and accountable</span></h2>
      </div>
      <div class="about-copy" data-reveal style="--i: 1">
        <p>
          Running a small business is hard enough. Yet most owners are told they need a website developer, an SEO specialist, a social
          media manager, an ads agency and now an “AI consultant” — each with their own invoices, logins and excuses.
        </p>
        <p>
          We bring all of that together in one team. Experienced strategists, designers and developers do the thinking; AI tools help us
          research, build and test faster. That combination lets us deliver agency-quality work at a pace and price that makes sense for
          small businesses.
        </p>
        <p>
          Whether you need your first professional website, want to show up on Google, or are ready for an app or smart automations,
          our job is the same: help you win more customers, and prove it.
        </p>
      </div>
    </div>
  </section>

  <section class="section theme-white" aria-labelledby="values-title">
    <div class="container">
      <div class="section-head section-head--center" data-reveal>
        <p class="eyebrow">What we believe</p>
        <h2 id="values-title">Values that guide <span class="text-gradient">every project</span></h2>
      </div>
      <div class="grid grid-4">
        {
          values.map((v, i) => (
            <article class="card spotlight lift value" data-reveal style={`--i: ${i}`}>
              <span class="icon-badge">
                <Icon name={v.icon} />
              </span>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section theme-dark ai-human" aria-labelledby="ai-human-title">
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="container">
      <div class="section-head section-head--center" data-reveal>
        <p class="eyebrow">AI-powered, human-led</p>
        <h2 id="ai-human-title">How we use AI — <span class="text-gradient">responsibly</span></h2>
        <p class="lead">AI is a tool, not a replacement for judgment. Here’s exactly how it fits into our work.</p>
      </div>
      <div class="grid grid-3">
        {
          aiSplit.map((col, i) => (
            <article class="card lift ai-col" data-reveal style={`--i: ${i}`}>
              <span class="icon-badge">
                <Icon name={col.icon} />
              </span>
              <h3>{col.title}</h3>
              <ul class="check-list" role="list">
                {col.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="compare-title">
    <div class="container container--narrow">
      <div class="section-head section-head--center" data-reveal>
        <p class="eyebrow">Why small businesses choose us</p>
        <h2 id="compare-title">The best of an agency, <span class="text-gradient">without the baggage</span></h2>
      </div>
      <div class="compare" data-reveal="scale" role="region" aria-label="Comparison table" tabindex="0">
        <table>
          <caption class="sr-only">Comparison of Digital AI Force, a typical agency and a DIY website builder</caption>
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Feature</span></th>
              <th scope="col" class="compare__us">Digital AI Force</th>
              <th scope="col">Typical agency</th>
              <th scope="col">DIY builder</th>
            </tr>
          </thead>
          <tbody>
            {
              compare.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  {[row.us, row.agency, row.diy].map((value, i) => (
                    <td class:list={{ compare__us: i === 0 }}>
                      {value === 'yes' && (
                        <span class="compare__yes">
                          <Icon name="check" size={18} strokeWidth={2.6} label="Yes" />
                        </span>
                      )}
                      {value === 'no' && (
                        <span class="compare__no">
                          <Icon name="minus" size={18} strokeWidth={2.6} label="No" />
                        </span>
                      )}
                      {value === 'varies' && <span class="compare__varies">Varies</span>}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <CTABand title="Let’s build something" accent="great together" />
</BaseLayout>

<style>
  .about-copy {
    display: grid;
    gap: 1.1rem;
    font-size: 1.1rem;
    color: var(--text-muted);
  }

  .value,
  .ai-col {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .value h3,
  .ai-col h3 {
    margin: 4px 0 0;
  }

  .ai-human {
    overflow: hidden;
  }

  .ai-human .container {
    position: relative;
  }

  .ai-col .check-list {
    margin-top: 6px;
  }

  .ai-col .check-list li {
    color: var(--on-night);
  }

  /* ---------- Comparison table ---------- */
  .compare {
    overflow-x: auto;
    border-radius: var(--radius-xl);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }

  .compare table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
  }

  .compare th,
  .compare td {
    padding: 16px 18px;
    text-align: center;
    border-bottom: 1px solid var(--line);
  }

  .compare tbody tr:last-child th,
  .compare tbody tr:last-child td {
    border-bottom: 0;
  }

  .compare thead th {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ink);
  }

  .compare tbody th {
    text-align: left;
    font-weight: 500;
    color: var(--ink);
  }

  .compare .compare__us {
    background: rgba(124, 92, 255, 0.07);
  }

  .compare thead .compare__us {
    color: var(--violet-600);
  }

  .compare__yes,
  .compare__no {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
  }

  .compare__yes {
    color: #fff;
    background: var(--grad-cta);
  }

  .compare__no {
    color: #9aa1bd;
    background: var(--paper);
  }

  .compare__varies {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--ink-muted);
    background: var(--paper);
    border: 1px solid var(--line);
  }

  .compare tbody tr {
    transition: background-color var(--dur-fast) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .compare tbody tr:hover {
      background: rgba(124, 92, 255, 0.03);
    }
  }
</style>
