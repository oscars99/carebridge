---
/** Process as sticky, stacking cards: each step pins and the next slides over it while scrolling. */
import Icon from './Icon.astro';

interface Step {
  title: string;
  text: string;
  icon?: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
const tones = ['surface', 'sand', 'ink', 'ember'];
---

<ol class="stack" role="list">
  {
    steps.map((step, i) => (
      <li class:list={['stack__card', `stack__card--${tones[i % tones.length]}`]} style={`--i: ${i}`}>
        <span class="stack__num" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <div class="stack__body">
          <p class="stack__kicker">
            Step {i + 1} of {steps.length}
          </p>
          <h3>{step.title}</h3>
          <p class="stack__text">{step.text}</p>
        </div>
        {step.icon && (
          <span class="stack__icon" aria-hidden="true">
            <Icon name={step.icon} size={28} strokeWidth={1.5} />
          </span>
        )}
      </li>
    ))
  }
</ol>

<style>
  .stack {
    display: grid;
    gap: clamp(20px, 4vh, 40px);
  }

  .stack__card {
    --card-bg: var(--surface);
    --card-fg: var(--ink);
    --card-muted: var(--ink-2);
    --card-num: var(--ember-ink);
    --card-line: var(--line);
    position: sticky;
    top: calc(var(--header-h) + 24px + var(--i) * 22px);
    display: grid;
    gap: 20px 40px;
    min-height: clamp(260px, 42vh, 380px);
    padding: clamp(26px, 4vw, 52px);
    border-radius: var(--radius-xl);
    color: var(--card-fg);
    background: var(--card-bg);
    border: 1px solid var(--card-line);
    box-shadow: 0 -24px 48px -36px rgba(20, 19, 17, 0.4);
  }

  .stack__card--sand {
    --card-bg: #e2dacb;
  }

  .stack__card--ink {
    --card-bg: var(--ink);
    --card-fg: var(--on-dark);
    --card-muted: var(--on-dark-2);
    --card-num: var(--ember);
    --card-line: var(--dark-line);
  }

  .stack__card--ember {
    --card-bg: var(--ember);
    --card-muted: rgba(20, 19, 17, 0.78);
    --card-num: var(--ink);
    --card-line: transparent;
  }

  @media (min-width: 760px) {
    .stack__card {
      grid-template-columns: minmax(150px, 0.8fr) 2fr auto;
      align-items: end;
    }
  }

  .stack__num {
    font-family: var(--font-display);
    font-size: clamp(5rem, 13vw, 11rem);
    line-height: 0.78;
    letter-spacing: -0.04em;
    color: var(--card-num);
  }

  .stack__body {
    display: grid;
    gap: 12px;
    max-width: 560px;
  }

  .stack__kicker {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--card-muted);
  }

  .stack__body h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.2rem, 4.2vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.015em;
    color: var(--card-fg);
  }

  .stack__text {
    font-size: 1.05rem;
    color: var(--card-muted);
  }

  .stack__icon {
    display: none;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    border: 1px solid currentColor;
    align-self: start;
  }

  @media (min-width: 760px) {
    .stack__icon {
      display: grid;
    }
  }
</style>
