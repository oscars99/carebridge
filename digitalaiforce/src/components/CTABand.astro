---
import Icon from './Icon.astro';
import { site } from '../config/site';

interface Props {
  title?: string;
  accent?: string;
  text?: string;
  primaryLabel?: string;
  primaryHref?: string;
}

const {
  title = 'Ready to grow your business',
  accent = 'online?',
  text = 'Book a free, no-pressure strategy call. We’ll review your website, search visibility and marketing, and show you the quickest wins.',
  primaryLabel = 'Book a free strategy call',
  primaryHref = '/contact/',
} = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta-band__card theme-dark" data-reveal="scale">
      <div class="cta-band__bg" aria-hidden="true">
        <div class="orb orb--violet cta-band__orb cta-band__orb--1"></div>
        <div class="orb orb--cyan cta-band__orb cta-band__orb--2"></div>
        <div class="bg-grid"></div>
      </div>
      <h2 id="cta-title">
        {title} <span class="text-gradient">{accent}</span>
      </h2>
      <p class="lead">{text}</p>
      <div class="btn-row cta-band__actions">
        <a href={primaryHref} class="btn btn--light btn--lg">
          {primaryLabel} <Icon name="arrow-right" class="icon--move" />
        </a>
        <a href={`mailto:${site.email}`} class="btn btn--ghost btn--lg">
          <Icon name="mail" /> Email us
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding-block: clamp(56px, 8vw, 104px);
    background: var(--paper);
  }

  .cta-band__card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(40px, 7vw, 88px) clamp(24px, 6vw, 80px);
    border-radius: var(--radius-xl);
    text-align: center;
    background: var(--night-950);
    box-shadow: 0 50px 100px -50px rgba(91, 61, 245, 0.6);
  }

  .cta-band__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .cta-band__orb--1 {
    width: 480px;
    height: 480px;
    left: -120px;
    top: -220px;
    opacity: 0.7;
    animation: drift 18s var(--ease-in-out) infinite;
  }

  .cta-band__orb--2 {
    width: 420px;
    height: 420px;
    right: -120px;
    bottom: -220px;
    opacity: 0.45;
    animation: drift 22s var(--ease-in-out) infinite reverse;
  }

  .cta-band h2 {
    max-width: 18ch;
    margin-inline: auto;
  }

  .cta-band .lead {
    margin: 18px auto 0;
  }

  .cta-band__actions {
    justify-content: center;
    margin-top: 32px;
  }
</style>
