---
import Icon from './Icon.astro';
import { site } from '../config/site';

interface Props {
  title?: string;
  accent?: string;
  text?: string;
  primaryLabel?: string;
  primaryHref?: string;
}

const {
  title = 'Ready to grow your business',
  accent = 'online?',
  text = 'Book a free, no-pressure strategy call. We’ll review your website, search visibility and marketing, and show you the quickest wins.',
  primaryLabel = 'Book a free strategy call',
  primaryHref = '/contact/',
} = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-title">
  <svg class="cta-band__star" viewBox="0 0 24 24" aria-hidden="true" data-speed="-0.12">
    <path d="M10.6 1h2.8v7.6l5.4-5.4 2 2-5.4 5.4H23v2.8h-7.6l5.4 5.4-2 2-5.4-5.4V23h-2.8v-7.6l-5.4 5.4-2-2 5.4-5.4H1v-2.8h7.6L3.2 5.2l2-2 5.4 5.4z"></path>
  </svg>
  <div class="container cta-band__inner">
    <p class="cta-band__kicker" data-reveal>Let’s talk</p>
    <h2 id="cta-title" data-split>
      {title} <span class="text-gradient">{accent}</span>
    </h2>
    <div class="cta-band__foot">
      <p class="lead" data-reveal>{text}</p>
      <div class="btn-row cta-band__actions" data-reveal style="--i: 1">
        <a href={primaryHref} class="btn btn--primary btn--lg">
          {primaryLabel} <Icon name="arrow-right" class="icon--move" />
        </a>
        <a href={`mailto:${site.email}`} class="btn btn--ghost btn--lg">
          <Icon name="mail" /> Email us
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band {
    --accent: var(--ink);
    --heading: var(--ink);
    --text-muted: rgba(20, 19, 17, 0.8);
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: clamp(80px, 11vw, 160px);
    color: var(--ink);
    background: var(--ember);
  }

  .cta-band__star {
    position: absolute;
    right: -6vw;
    top: 8%;
    z-index: -1;
    width: clamp(260px, 38vw, 560px);
    height: auto;
    fill: rgba(20, 19, 17, 0.08);
    animation: spin 60s linear infinite;
  }

  .cta-band__kicker {
    margin-bottom: 1.4rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .cta-band h2 {
    max-width: 15ch;
    font-size: clamp(3rem, 8.4vw, 8rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
  }

  .cta-band__foot {
    display: grid;
    gap: 28px;
    align-items: end;
    margin-top: clamp(36px, 5vw, 64px);
    padding-top: clamp(24px, 3vw, 36px);
    border-top: 1px solid rgba(20, 19, 17, 0.3);
  }

  @media (min-width: 900px) {
    .cta-band__foot {
      grid-template-columns: 1fr auto;
      gap: 64px;
    }
  }

  .cta-band .lead {
    color: var(--text-muted);
  }

  .cta-band .btn--primary {
    --btn-hover-bg: var(--paper);
    --btn-hover-fg: var(--ink);
  }

  .cta-band .btn--ghost {
    border-color: rgba(20, 19, 17, 0.45);
    --btn-hover-bg: var(--ink);
    --btn-hover-fg: var(--paper);
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-band__star {
      animation: none;
    }
  }
</style>
