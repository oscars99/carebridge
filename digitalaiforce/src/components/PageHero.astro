---
/** Editorial hero used at the top of every inner page. */
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from '../lib/schema';

interface Props {
  eyebrow?: string;
  title: string;
  accent?: string;
  intro?: string;
  crumbs?: Crumb[];
  align?: 'left' | 'center';
  size?: 'default' | 'large';
}

const { eyebrow, title, accent, intro, crumbs, align = 'left', size = 'default' } = Astro.props;
---

<section class:list={['page-hero', `page-hero--${align}`, `page-hero--${size}`]}>
  <div class="bg-grid page-hero__grid" aria-hidden="true"></div>
  <div class="container page-hero__inner">
    <div class="page-hero__main">
      {crumbs && <div class="enter" style="--d: 0"><Breadcrumbs crumbs={crumbs} /></div>}
      {eyebrow && <p class="eyebrow enter" style="--d: 1">{eyebrow}</p>}
      <h1 data-split>
        {title} {accent && <span class="text-gradient">{accent}</span>}
      </h1>
      {intro && <p class="lead enter" style="--d: 4">{intro}</p>}
      <slot />
    </div>
    <slot name="aside" />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: clip;
    isolation: isolate;
    padding-top: calc(var(--header-h) + clamp(40px, 6vw, 88px));
    padding-bottom: clamp(56px, 7vw, 104px);
    border-bottom: 1px solid var(--line);
  }

  .page-hero__grid {
    z-index: -1;
    opacity: 0.5;
  }

  .page-hero__inner {
    display: grid;
    gap: 48px;
    align-items: end;
  }

  @media (min-width: 1080px) {
    .page-hero__inner:has(> :nth-child(2)) {
      grid-template-columns: 1.3fr 0.7fr;
      gap: 72px;
    }
  }

  .page-hero__main {
    max-width: 1000px;
  }

  .page-hero .crumbs {
    margin-bottom: 32px;
  }

  .page-hero h1 {
    font-size: clamp(2.9rem, 6.6vw, 6rem);
    line-height: 0.92;
    letter-spacing: -0.025em;
  }

  .page-hero .lead {
    margin-top: clamp(24px, 3vw, 36px);
  }

  .page-hero--large h1 {
    font-size: clamp(3.3rem, 9vw, 8.4rem);
    line-height: 0.88;
  }

  .page-hero--center .page-hero__main {
    margin-inline: auto;
    text-align: center;
  }

  .page-hero--center .lead {
    margin-inline: auto;
  }

  .page-hero--center :global(.crumbs ol) {
    justify-content: center;
  }
</style>
