---
/** Digital AI Force logo: ink "D" monogram with an ember dot + serif wordmark. */
interface Props {
  /** Kept for API compatibility (the mark no longer uses gradient IDs). */
  id?: string;
  showText?: boolean;
  size?: number;
}

const { showText = true, size = 34 } = Astro.props;
---

<span class="logo">
  <svg class="logo__mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <rect class="logo__tile" width="32" height="32" rx="8"></rect>
    <path class="logo__d" d="M10.5 8.5v15h4.25a7.5 7.5 0 0 0 0-15z" fill="none" stroke-width="3" stroke-linejoin="round"></path>
    <circle class="logo__dot" cx="24.75" cy="23.75" r="2.25"></circle>
  </svg>
  {
    showText && (
      <span class="logo__text">
        Digital <span class="logo__ai">AI</span> Force
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.6rem;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--heading, var(--ink));
    white-space: nowrap;
  }

  .logo__mark {
    flex: none;
  }

  .logo__tile {
    fill: var(--heading, var(--ink));
  }

  .logo__d {
    stroke: var(--bg, var(--paper));
  }

  .logo__dot {
    fill: var(--ember);
    transform-origin: 24.75px 23.75px;
    transition: transform 0.6s var(--ease-spring);
  }

  .logo__ai {
    font-style: italic;
    color: var(--accent, var(--ember-ink));
  }

  :global(.menu-open .site-header) .logo {
    --heading: var(--on-dark);
    --bg: var(--ink);
    --accent: var(--ember);
  }

  @media (hover: hover) and (pointer: fine) {
    :global(a:hover) > .logo .logo__dot {
      transform: scale(1.5);
    }
  }

  @media (forced-colors: active) {
    .logo__tile {
      fill: CanvasText;
    }

    .logo__d {
      stroke: Canvas;
    }
  }
</style>
