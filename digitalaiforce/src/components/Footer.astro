---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { services, serviceUrl } from '../data/services';
import { site } from '../config/site';

const year = new Date().getFullYear();
const company = [
  { label: 'About us', href: '/about/' },
  { label: 'Pricing', href: '/pricing/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Contact', href: '/contact/' },
];
const legal = [
  { label: 'Privacy policy', href: '/privacy/' },
  { label: 'Terms of service', href: '/terms/' },
  { label: 'Sitemap', href: '/sitemap-index.xml' },
];
---

<footer class="site-footer theme-dark">
  <div class="container">
    <div class="site-footer__lede">
      <p class="site-footer__big">Have a project in mind? <em>Let’s talk.</em></p>
      <a class="site-footer__mail" href={`mailto:${site.email}`}>
        {site.email}
        <Icon name="arrow-up-right" size={28} strokeWidth={1.5} />
      </a>
    </div>

    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="/" aria-label={`${site.name} — home`} class="site-footer__logo"><Logo id="footer" /></a>
        <p class="site-footer__tagline">
          AI-powered, human-led digital agency helping small businesses grow with websites, SEO, marketing, mobile apps and smart
          automation.
        </p>
        <a href="/contact/" class="btn btn--primary btn--sm">
          Get a free quote <Icon name="arrow-right" class="icon--move" />
        </a>
      </div>

      <nav class="site-footer__col" aria-label="Services">
        <p class="site-footer__heading">Services</p>
        <ul role="list">
          {
            services.map((s) => (
              <li>
                <a href={serviceUrl(s.slug)}>{s.navLabel}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="site-footer__col" aria-label="Company">
        <p class="site-footer__heading">Company</p>
        <ul role="list">
          {
            company.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))
          }
        </ul>
        <p class="site-footer__heading site-footer__heading--spaced">Legal</p>
        <ul role="list">
          {
            legal.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="site-footer__col">
        <p class="site-footer__heading">Get in touch</p>
        <ul role="list" class="site-footer__contact">
          <li>
            <a href={`mailto:${site.email}`}><Icon name="mail" size={18} />{site.email}</a>
          </li>
          {
            site.phone && (
              <li>
                <a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`}>
                  <Icon name="phone" size={18} />
                  {site.phone}
                </a>
              </li>
            )
          }
          {
            site.location && (
              <li>
                <span>
                  <Icon name="map-pin" size={18} />
                  {site.location}
                </span>
              </li>
            )
          }
          <li>
            <span><Icon name="clock" size={18} />Replies {site.responseTime}</span>
          </li>
        </ul>
        {
          site.socials.length > 0 && (
            <ul role="list" class="site-footer__socials">
              {site.socials.map((s) => (
                <li>
                  <a href={s.href} rel="noopener me" target="_blank">
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>

    <div class="site-footer__wordmark" aria-hidden="true">Digital <em>AI</em> Force</div>

    <div class="site-footer__bottom">
      <p>
        © {year} {site.legalName}. All rights reserved.
        {site.parentCompany && <>{' '}A {site.parentCompany} company.</>}
      </p>
      <p>Websites · SEO · Marketing · Apps · AI</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--dark-line);
    padding-top: clamp(72px, 9vw, 128px);
    padding-bottom: max(28px, env(safe-area-inset-bottom));
  }

  .site-footer__lede {
    display: grid;
    gap: 24px;
    padding-bottom: clamp(48px, 6vw, 80px);
    margin-bottom: clamp(48px, 6vw, 72px);
    border-bottom: 1px solid var(--dark-line);
  }

  .site-footer__big {
    max-width: 14ch;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 7vw, 6.4rem);
    line-height: 0.92;
    letter-spacing: -0.025em;
    color: var(--on-dark);
  }

  .site-footer__big em {
    color: var(--ember);
  }

  .site-footer__mail {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    justify-self: start;
    padding-bottom: 6px;
    font-size: clamp(1.15rem, 2.2vw, 1.6rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--on-dark);
    background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat;
    transition:
      color var(--dur) ease,
      background-size 0.5s var(--ease-out);
    overflow-wrap: anywhere;
  }

  .site-footer__mail :global(.icon) {
    flex: none;
    transition: transform 0.5s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .site-footer__mail:hover {
      color: var(--ember);
      background-size: 0% 1px;
    }

    .site-footer__mail:hover :global(.icon) {
      transform: rotate(45deg);
    }
  }

  @media (min-width: 900px) {
    .site-footer__lede {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }

  .site-footer__top {
    display: grid;
    gap: 40px 32px;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .site-footer__top {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .site-footer__top {
      grid-template-columns: 1.5fr 1fr 0.8fr 1.1fr;
    }
  }

  .site-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    max-width: 360px;
  }

  .site-footer__logo {
    border-radius: 8px;
  }

  .site-footer__tagline {
    color: var(--on-dark-2);
    font-size: 0.98rem;
  }

  .site-footer__brand .btn {
    --btn-bg: var(--ember);
    --btn-fg: var(--ink);
    --btn-hover-bg: var(--paper);
  }

  .site-footer__heading {
    margin-bottom: 14px;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-dark-2);
  }

  .site-footer__heading--spaced {
    margin-top: 28px;
  }

  .site-footer__col ul {
    display: grid;
    gap: 2px;
  }

  .site-footer__col a,
  .site-footer__contact span {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 34px;
    color: var(--on-dark);
    font-size: 0.97rem;
    transition:
      color var(--dur-fast) ease,
      translate 0.4s var(--ease-out);
  }

  .site-footer__contact span {
    color: var(--on-dark-2);
  }

  .site-footer__contact :global(.icon) {
    color: var(--ember);
    flex: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .site-footer__col a:hover {
      color: var(--ember);
      translate: 4px 0;
    }
  }

  .site-footer__socials {
    display: flex !important;
    flex-wrap: wrap;
    gap: 8px 16px !important;
    margin-top: 12px;
  }

  .site-footer__wordmark {
    margin-top: clamp(56px, 8vw, 104px);
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 15.4vw, 15rem);
    line-height: 0.82;
    letter-spacing: -0.04em;
    text-align: center;
    white-space: nowrap;
    color: var(--on-dark);
    user-select: none;
  }

  .site-footer__wordmark em {
    color: var(--ember);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 24px;
    margin-top: clamp(24px, 3vw, 40px);
    border-top: 1px solid var(--dark-line);
    font-size: 0.88rem;
    color: var(--on-dark-2);
  }
</style>
