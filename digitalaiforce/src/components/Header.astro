---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { services, serviceUrl } from '../data/services';
import { site } from '../config/site';

const path = Astro.url.pathname;
const links = [
  { label: 'Pricing', href: '/pricing/' },
  { label: 'About', href: '/about/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Contact', href: '/contact/' },
];
const isActive = (href: string) => path === href || path.startsWith(href);
const servicesActive = path.startsWith('/services/');
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand" aria-label={`${site.name} — home`}>
      <Logo id="header" />
    </a>

    <nav class="site-nav" aria-label="Main">
      <ul class="site-nav__list" role="list">
        <li class="site-nav__item" data-mega>
          <a href="/services/" class="site-nav__link" aria-current={servicesActive ? 'page' : undefined}>Services</a>
          <button
            class="site-nav__toggle"
            type="button"
            aria-expanded="false"
            aria-controls="mega-services"
            data-mega-toggle
          >
            <span class="sr-only">Show services</span>
            <Icon name="chevron-down" size={16} strokeWidth={2.25} />
          </button>
          <div class="mega" id="mega-services" data-mega-panel>
            <div class="mega__panel">
              <ul class="mega__grid" role="list">
                {
                  services.map((s, i) => (
                    <li>
                      <a href={serviceUrl(s.slug)} class="mega__link" aria-current={path === serviceUrl(s.slug) ? 'page' : undefined}>
                        <span class="mega__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                        <span class="mega__text">
                          <span class="mega__title">{s.navLabel}</span>
                          <span class="mega__desc">{s.tagline}</span>
                        </span>
                      </a>
                    </li>
                  ))
                }
              </ul>
              <div class="mega__aside">
                <p class="mega__aside-title">Not sure where to <em>start?</em></p>
                <p class="mega__aside-text">Book a free strategy call and get a clear, no-pressure plan for growing your business online.</p>
                <a href="/contact/" class="btn btn--primary btn--sm">
                  Book a free call <Icon name="arrow-right" class="icon--move" />
                </a>
                <a href="/services/" class="link-arrow mega__all">All services <Icon name="arrow-right" /></a>
              </div>
            </div>
          </div>
        </li>
        {
          links.map((l) => (
            <li class="site-nav__item">
              <a href={l.href} class="site-nav__link" aria-current={isActive(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href="/contact/" class="btn btn--primary btn--sm site-header__cta">
        Get a free quote <Icon name="arrow-right" class="icon--move" />
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="sr-only" data-menu-label>Open menu</span>
        <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu>
  <nav class="mobile-menu__nav container" aria-label="Mobile">
    <ul class="mobile-menu__list" role="list">
      <li style="--i: 0">
        <details class="mobile-menu__group" open={servicesActive}>
          <summary>
            Services <Icon name="chevron-down" size={20} />
          </summary>
          <ul role="list" class="mobile-menu__sub">
            {
              services.map((s, i) => (
                <li>
                  <a href={serviceUrl(s.slug)} aria-current={path === serviceUrl(s.slug) ? 'page' : undefined}>
                    <span class="mobile-menu__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                    {s.navLabel}
                  </a>
                </li>
              ))
            }
            <li>
              <a href="/services/" class="mobile-menu__all">
                All services <Icon name="arrow-right" size={18} />
              </a>
            </li>
          </ul>
        </details>
      </li>
      {
        links.map((l, i) => (
          <li style={`--i: ${i + 1}`}>
            <a href={l.href} class="mobile-menu__link" aria-current={isActive(l.href) ? 'page' : undefined}>
              {l.label}
              <Icon name="arrow-up-right" size={22} />
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mobile-menu__footer" style={`--i: ${links.length + 1}`}>
      <a href="/contact/" class="btn btn--primary btn--lg btn--block">
        Get a free quote <Icon name="arrow-right" class="icon--move" />
      </a>
      <a href={`mailto:${site.email}`} class="mobile-menu__email">
        <Icon name="mail" size={18} />
        {site.email}
      </a>
    </div>
  </nav>
</div>

<style>
  /* ---------- Bar ---------- */
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-header);
    height: var(--header-h);
    color: var(--ink);
    transition: translate 0.55s var(--ease-out);
  }

  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(242, 238, 230, 0);
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--dur) ease,
      border-color var(--dur) ease;
  }

  :global(.header-scrolled) .site-header::before {
    background: rgba(242, 238, 230, 0.86);
    border-bottom-color: var(--line);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
  }

  :global(.menu-open) .site-header {
    color: var(--on-dark);
  }

  :global(.menu-open) .site-header::before {
    background: transparent;
    border-bottom-color: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  :global(.header-hidden) .site-header {
    translate: 0 -105%;
  }

  .site-header__inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: 24px;
    height: 100%;
  }

  .site-header__brand {
    display: inline-flex;
    padding: 6px 0;
    border-radius: 8px;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }

  /* ---------- Desktop nav ---------- */
  .site-nav {
    display: none;
    margin-left: auto;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .site-nav__item {
    display: flex;
    align-items: center;
  }

  .site-nav__link {
    position: relative;
    padding: 10px 12px;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink);
    transition: color var(--dur-fast) ease;
  }

  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 6px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.45s var(--ease-out);
  }

  .site-nav__link[aria-current='page']::after {
    transform: scaleX(1);
  }

  .site-nav__link[aria-current='page']::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 50%;
    width: 5px;
    height: 5px;
    margin-top: -3px;
    background: var(--ember);
  }

  [data-mega] .site-nav__link {
    padding-right: 4px;
  }

  [data-mega] .site-nav__link::after {
    right: 4px;
  }

  .site-nav__toggle {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    color: var(--ink);
    transition:
      transform var(--dur) var(--ease-out),
      background-color var(--dur-fast) ease;
  }

  [data-mega].is-open .site-nav__toggle {
    transform: rotate(180deg);
  }

  @media (hover: hover) and (pointer: fine) {
    .site-nav__link:hover::after {
      transform: scaleX(1);
      transform-origin: left;
    }

    .site-nav__toggle:hover {
      background: rgba(20, 19, 17, 0.07);
    }
  }

  /* ---------- Mega menu ---------- */
  .mega {
    position: absolute;
    top: calc(100% - 6px);
    left: 0;
    right: 0;
    width: min(980px, calc(100vw - 32px));
    margin-inline: auto;
    padding-top: 10px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition:
      opacity 0.22s ease,
      transform 0.4s var(--ease-out),
      visibility 0s linear 0.4s;
  }

  [data-mega].is-open .mega {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.25s ease,
      transform 0.45s var(--ease-out),
      visibility 0s;
  }

  .mega__panel {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 8px;
    padding: 8px;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
  }

  .mega__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 8px;
    padding: 8px 12px;
  }

  .mega__link {
    display: flex;
    gap: 14px;
    align-items: baseline;
    padding: 14px 6px;
    border-bottom: 1px solid var(--line);
    transition: padding var(--dur) var(--ease-out);
  }

  .mega__grid li:nth-last-child(-n + 2) .mega__link {
    border-bottom: 0;
  }

  .mega__num {
    flex: none;
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--ember-ink);
  }

  .mega__text {
    display: grid;
    gap: 3px;
  }

  .mega__title {
    font-weight: 600;
    font-size: 0.98rem;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .mega__desc {
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--ink-2);
  }

  .mega__link[aria-current='page'] .mega__title {
    color: var(--ember-ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .mega__link:hover {
      padding-left: 12px;
    }

    .mega__link:hover .mega__title {
      color: var(--ember-ink);
    }
  }

  .mega__aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: 26px;
    border-radius: 10px;
    color: var(--on-dark);
    background: var(--ink);
  }

  .mega__aside-title {
    font-family: var(--font-display);
    font-size: 1.9rem;
    line-height: 1;
    color: var(--on-dark);
  }

  .mega__aside-title em {
    color: var(--ember);
  }

  .mega__aside-text {
    font-size: 0.9rem;
    color: var(--on-dark-2);
    margin-bottom: 6px;
  }

  .mega__aside .btn {
    --btn-bg: var(--paper);
    --btn-fg: var(--ink);
  }

  .mega__all {
    font-size: 0.92rem;
    margin-top: auto;
    color: var(--on-dark) !important;
  }

  /* ---------- Menu toggle ---------- */
  .menu-toggle {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    color: inherit;
    border: 1px solid currentColor;
    transition: background-color var(--dur-fast) ease;
  }

  .menu-toggle__bars {
    position: relative;
    display: block;
    width: 18px;
    height: 8px;
  }

  .menu-toggle__bars span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transition:
      transform 0.45s var(--ease-out),
      top 0.45s var(--ease-out);
  }

  .menu-toggle__bars span:first-child {
    top: 0;
  }

  .menu-toggle__bars span:last-child {
    top: 6.5px;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bars span:first-child {
    top: 3.25px;
    transform: rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bars span:last-child {
    top: 3.25px;
    transform: rotate(-45deg);
  }

  .site-header__cta {
    display: none;
  }

  :global(.menu-open) .site-header__cta {
    --btn-bg: var(--paper);
    --btn-fg: var(--ink);
  }

  @media (min-width: 560px) {
    .site-header__cta {
      display: inline-flex;
    }
  }

  @media (min-width: 1080px) {
    .site-nav {
      display: block;
    }

    .site-header__actions {
      margin-left: 12px;
    }

    .menu-toggle {
      display: none;
    }
  }

  /* ---------- Mobile menu ---------- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-menu);
    display: flex;
    flex-direction: column;
    padding-top: var(--header-h);
    overflow-y: auto;
    overscroll-behavior: contain;
    color: var(--on-dark);
    background: var(--ink);
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    transition:
      clip-path 0.7s var(--ease-in-out),
      visibility 0s linear 0.7s;
  }

  .mobile-menu.is-open {
    clip-path: inset(0 0 0 0);
    visibility: visible;
    transition:
      clip-path 0.7s var(--ease-in-out),
      visibility 0s;
  }

  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
    gap: 28px;
    flex: 1;
    padding-block: 20px max(28px, env(safe-area-inset-bottom));
  }

  .mobile-menu__list {
    display: grid;
  }

  .mobile-menu__list > li,
  .mobile-menu__footer {
    opacity: 0;
    translate: 0 28px;
    transition:
      opacity 0.4s ease,
      translate 0.7s var(--ease-out);
  }

  .mobile-menu.is-open .mobile-menu__list > li,
  .mobile-menu.is-open .mobile-menu__footer {
    opacity: 1;
    translate: 0 0;
    transition-delay: calc(var(--i, 0) * 60ms + 260ms);
  }

  .mobile-menu__link,
  .mobile-menu__group summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 68px;
    padding-block: 12px;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 9vw, 3.4rem);
    line-height: 1;
    color: var(--on-dark);
    border-bottom: 1px solid var(--dark-line);
  }

  .mobile-menu__link :global(.icon) {
    color: var(--on-dark-2);
  }

  .mobile-menu__link[aria-current='page'] {
    font-style: italic;
    color: var(--ember);
  }

  .mobile-menu__group summary {
    cursor: pointer;
    list-style: none;
  }

  .mobile-menu__group summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu__group summary :global(.icon) {
    color: var(--on-dark-2);
    transition: transform var(--dur) var(--ease-out);
  }

  .mobile-menu__group[open] summary :global(.icon) {
    transform: rotate(180deg);
  }

  .mobile-menu__sub {
    display: grid;
    padding: 8px 0 16px;
    border-bottom: 1px solid var(--dark-line);
  }

  .mobile-menu__sub a {
    display: flex;
    align-items: baseline;
    gap: 14px;
    min-height: 46px;
    padding: 10px 0;
    font-size: 1.05rem;
    color: var(--on-dark);
  }

  .mobile-menu__num {
    font-family: var(--font-display);
    color: var(--ember);
    flex: none;
  }

  .mobile-menu__sub a[aria-current='page'] {
    color: var(--ember);
  }

  .mobile-menu__all {
    align-items: center !important;
    font-weight: 600;
    color: var(--ember) !important;
  }

  .mobile-menu__footer {
    display: grid;
    gap: 16px;
    margin-top: auto;
  }

  .mobile-menu__footer .btn {
    --btn-bg: var(--ember);
    --btn-fg: var(--ink);
    --btn-hover-bg: var(--paper);
  }

  .mobile-menu__email {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    color: var(--on-dark-2);
  }

  @media (min-width: 1080px) {
    .mobile-menu {
      display: none;
    }
  }
</style>
