---
/**
 * Accessible FAQ accordion built on native <details>/<summary> (works without JS;
 * JS adds smooth height animation). Pair with faqNode() in the page schema.
 */
import Icon from './Icon.astro';

interface Props {
  faqs: { q: string; a: string }[];
  headingLevel?: 'h3' | 'h4';
}

const { faqs, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<div class="faq">
  {
    faqs.map((f, i) => (
      <details class="faq__item" data-accordion data-reveal style={`--i: ${i % 4}`}>
        <summary class="faq__q">
          <Heading class="faq__title">{f.q}</Heading>
          <span class="faq__icon" aria-hidden="true">
            <Icon name="plus" size={20} strokeWidth={1.75} />
          </span>
        </summary>
        <div class="faq__a" data-accordion-content>
          <p>{f.a}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: grid;
    border-top: 1px solid var(--line-strong);
  }

  .faq__item {
    border-bottom: 1px solid var(--line-strong);
  }

  .theme-dark .faq,
  .theme-dark .faq__item {
    border-color: var(--dark-line);
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 0;
    cursor: pointer;
    list-style: none;
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.4rem, 2.1vw, 1.8rem);
    letter-spacing: -0.01em;
    line-height: 1.15;
    transition:
      color var(--dur) ease,
      translate 0.5s var(--ease-out);
  }

  .faq__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: var(--heading);
    border: 1px solid var(--border);
    transition:
      transform 0.5s var(--ease-out),
      background-color 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease;
  }

  .faq__item[open] .faq__icon {
    transform: rotate(135deg);
    color: var(--ink);
    background: var(--ember);
    border-color: var(--ember);
  }

  .faq__item[open] .faq__title {
    font-style: italic;
  }

  .faq__a {
    overflow: hidden;
  }

  .faq__a p {
    padding: 0 64px 28px 0;
    color: var(--text-muted);
    max-width: 70ch;
  }

  @media (hover: hover) and (pointer: fine) {
    .faq__q:hover .faq__title {
      translate: 8px 0;
    }

    .faq__q:hover .faq__icon {
      border-color: var(--heading);
    }
  }
</style>
