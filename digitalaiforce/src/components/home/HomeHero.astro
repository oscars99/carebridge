---
import Icon from '../Icon.astro';
import Marquee from '../Marquee.astro';
import { marqueeServices } from '../../data/home';

const rotatorWords = ['websites that convert.', 'SEO that ranks.', 'ads that pay off.', 'apps customers love.', 'AI that works 24/7.'];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="bg-grid hero__grid" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__meta enter" style="--d: 0">
      <p class="eyebrow hero__eyebrow">Digital agency for small businesses</p>
      <a href="/services/ai-automation/" class="pill hero__pill">
        <span class="pill__tag">AI</span>{' '}
        Chatbots that work 24/7
        <Icon name="arrow-up-right" size={16} strokeWidth={2} />
      </a>
    </div>

    <h1 id="hero-title" class="display hero__title" data-split>
      Websites, SEO &amp; marketing that <span class="text-gradient">grow small businesses</span>
    </h1>

    <div class="hero__foot">
      <p class="lead hero__lead enter" style="--d: 4">
        Digital AI Force is a full-service digital agency that pairs human strategy with AI speed — fast websites, top Google rankings,
        ads, mobile apps and smart automations, all handled for you.
      </p>

      <div class="hero__actions enter" style="--d: 5">
        <p class="hero__rotator">
          <span class="sr-only">We build websites that convert, SEO that ranks, ads that pay off, apps customers love and AI that works 24/7.</span>
          <span aria-hidden="true" class="hero__rotator-line">
            <span class="hero__rotator-label">We build</span>
            <span class="rotator" data-rotator>
              {rotatorWords.map((w, i) => <span class:list={['rotator__word', { 'is-active': i === 0 }]}>{w}</span>)}
            </span>
          </span>
        </p>
        <div class="btn-row">
          <a href="/contact/" class="btn btn--primary btn--lg">
            Get a free quote <Icon name="arrow-right" class="icon--move" />
          </a>
          <a href="/services/" class="btn btn--ghost btn--lg">Explore services</a>
        </div>
        <ul class="hero__trust" role="list">
          <li>Free strategy call</li>
          <li>No long-term contracts</li>
          <li>You own everything</li>
        </ul>
      </div>

      <a href="/contact/" class="badge enter" style="--d: 6" aria-hidden="true" tabindex="-1">
        <svg class="badge__ring" viewBox="0 0 200 200" aria-hidden="true">
          <defs>
            <path id="badge-circle" d="M100 100m-78 0a78 78 0 1 1 156 0a78 78 0 1 1-156 0"></path>
          </defs>
          <text>
            <textPath href="#badge-circle" startOffset="0" textLength="486" lengthAdjust="spacing">Free strategy call • No pressure • Free strategy call • No pressure •</textPath>
          </text>
        </svg>
        <span class="badge__core" aria-hidden="true">
          <Icon name="arrow-up-right" size={30} strokeWidth={1.5} />
        </span>
      </a>
    </div>
  </div>

  <div class="hero__marquee">
    <Marquee items={marqueeServices} tilt />
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-top: calc(var(--header-h) + clamp(28px, 5vw, 72px));
    isolation: isolate;
  }

  .hero__grid {
    z-index: -1;
    opacity: 0.35;
  }

  @media (max-width: 699px) {
    .hero__grid {
      display: none;
    }
  }

  .hero__inner {
    display: grid;
    gap: clamp(28px, 4vw, 48px);
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
  }

  .hero__eyebrow {
    margin: 0;
  }

  .hero__pill {
    transition:
      border-color var(--dur) ease,
      background-color var(--dur) ease;
  }

  .hero__pill :global(.icon) {
    transition: transform 0.45s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .hero__pill:hover {
      border-color: var(--ink);
      background: #fff;
    }

    .hero__pill:hover :global(.icon) {
      transform: translate(2px, -2px);
    }
  }

  .hero__title {
    max-width: none;
    font-size: clamp(3.3rem, 9.2vw, 9.4rem);
    line-height: 0.88;
    letter-spacing: -0.03em;
  }

  .hero__title :global(.text-gradient) {
    letter-spacing: -0.02em;
  }

  .hero__foot {
    display: grid;
    gap: 32px;
    align-items: end;
    padding-top: clamp(20px, 3vw, 36px);
    border-top: 1px solid var(--line);
  }

  @media (min-width: 900px) {
    .hero__foot {
      grid-template-columns: 1fr 1.1fr auto;
      gap: clamp(32px, 4vw, 64px);
    }
  }

  .hero__lead {
    max-width: 44ch;
    font-size: clamp(1.05rem, 1.3vw, 1.2rem);
  }

  .hero__actions {
    display: grid;
    gap: 22px;
  }

  .hero__rotator {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.4vw, 2.1rem);
    line-height: 1.15;
    color: var(--ink);
  }

  .hero__rotator-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.3em;
  }

  .rotator {
    position: relative;
    display: inline-grid;
    overflow: clip;
    font-style: italic;
    color: var(--ember-ink);
  }

  .rotator__word {
    grid-area: 1 / 1;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(100%);
    transition:
      transform 0.65s var(--ease-out),
      opacity 0.4s ease;
  }

  .rotator__word.is-active {
    opacity: 1;
    transform: none;
  }

  .rotator__word.is-leaving {
    opacity: 0;
    transform: translateY(-100%);
  }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-size: 0.9rem;
    color: var(--ink-2);
  }

  .hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .hero__trust li::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--ember);
  }

  /* ---------- Rotating badge ---------- */
  .badge {
    position: relative;
    display: none;
    place-items: center;
    width: 168px;
    height: 168px;
    border-radius: 50%;
    color: var(--ink);
    justify-self: end;
  }

  @media (min-width: 900px) {
    .badge {
      display: grid;
    }
  }

  .badge__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: spin 22s linear infinite;
  }

  .badge__ring text {
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: currentColor;
  }

  .badge__core {
    display: grid;
    place-items: center;
    width: 92px;
    height: 92px;
    border-radius: 50%;
    color: var(--ink);
    background: var(--ember);
    transition:
      transform 0.6s var(--ease-spring),
      background-color var(--dur) ease,
      color var(--dur) ease;
  }

  .badge__core :global(.icon) {
    transition: transform 0.6s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .badge:hover .badge__core {
      transform: scale(1.1);
      color: var(--paper);
      background: var(--ink);
    }

    .badge:hover .badge__core :global(.icon) {
      transform: rotate(45deg);
    }

    .badge:hover .badge__ring {
      animation-duration: 8s;
    }
  }

  .hero__marquee {
    padding-block: clamp(56px, 7vw, 104px) clamp(40px, 5vw, 72px);
  }

  @media (prefers-reduced-motion: reduce) {
    .badge__ring {
      animation: none;
    }
  }
</style>
