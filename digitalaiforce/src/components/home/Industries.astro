---
import Icon from '../Icon.astro';
import { industries } from '../../data/home';
---

<ul class="industries" role="list">
  {
    industries.map((ind, i) => (
      <li class="industries__item" data-reveal style={`--i: ${i % 3}`}>
        <span class="industries__num" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <span class="industries__name">{ind.name}</span>
        <span class="industries__icon" aria-hidden="true">
          <Icon name={ind.icon} size={22} strokeWidth={1.5} />
        </span>
      </li>
    ))
  }
</ul>

<style>
  .industries {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }

  @media (min-width: 760px) {
    .industries {
      grid-template-columns: 1fr 1fr;
      column-gap: clamp(32px, 5vw, 80px);
    }
  }

  @media (min-width: 1100px) {
    .industries {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  .industries__item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-block: 20px;
    border-bottom: 1px solid var(--line-strong);
  }

  .industries__num {
    flex: none;
    width: 2ch;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink-2);
  }

  .industries__name {
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 2.3vw, 2rem);
    line-height: 1.05;
    transition:
      color var(--dur) ease,
      translate 0.5s var(--ease-out);
  }

  .industries__icon {
    display: grid;
    place-items: center;
    margin-left: auto;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: var(--ink);
    transition:
      background-color var(--dur) ease,
      transform 0.5s var(--ease-spring);
  }

  @media (hover: hover) and (pointer: fine) {
    .industries__item:hover .industries__name {
      color: var(--ember-ink);
      font-style: italic;
      translate: 8px 0;
    }

    .industries__item:hover .industries__icon {
      background: var(--ember);
      transform: rotate(-8deg) scale(1.05);
    }
  }
</style>
