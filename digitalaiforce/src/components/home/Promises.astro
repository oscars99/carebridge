---
import { promises } from '../../data/home';
---

<section class="promises theme-dark" aria-labelledby="promises-title">
  <div class="promises__glow" aria-hidden="true"></div>
  <div class="container">
    <div class="promises__inner">
      <div class="promises__intro" data-reveal>
        <p class="eyebrow">Our promise</p>
        <h2 id="promises-title">Built for performance. <span class="text-gradient">Backed by commitments.</span></h2>
      </div>
      <dl class="promises__grid">
        {
          promises.map((p, i) => (
            <div class="promises__item" data-reveal style={`--i: ${i}`}>
              <dt class="sr-only">{p.label}</dt>
              <dd class="promises__value">
                <span data-count={p.value} data-suffix={p.suffix}>
                  {p.value}
                  {p.suffix}
                </span>
              </dd>
              <dd class="promises__label" aria-hidden="true">
                {p.label}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .promises {
    position: relative;
    overflow: hidden;
    padding-block: clamp(64px, 8vw, 104px);
    background:
      radial-gradient(60% 120% at 0% 0%, rgba(124, 92, 255, 0.35), transparent 60%),
      radial-gradient(50% 120% at 100% 100%, rgba(34, 211, 238, 0.22), transparent 60%),
      var(--night-900);
  }

  .promises__glow {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 40px 40px;
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 40%, transparent);
    mask-image: linear-gradient(180deg, transparent, #000 40%, transparent);
    pointer-events: none;
  }

  .promises__inner {
    position: relative;
    display: grid;
    gap: 40px;
  }

  @media (min-width: 1080px) {
    .promises__inner {
      grid-template-columns: 0.8fr 1.2fr;
      align-items: center;
      gap: 64px;
    }
  }

  .promises__intro h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
  }

  .promises__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin: 0;
  }

  @media (min-width: 720px) {
    .promises__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 1080px) {
    .promises__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .promises__item {
    padding: 22px 20px;
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .promises__item dd {
    margin: 0;
  }

  .promises__value {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.2vw, 3.2rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    background: var(--grad-text-on-dark);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .promises__label {
    margin-top: 10px !important;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--on-night-muted);
  }
</style>
