---
import { promises } from '../../data/home';
---

<section class="promises" aria-labelledby="promises-title">
  <div class="container">
    <div class="promises__inner">
      <div class="promises__intro" data-reveal>
        <p class="eyebrow">Our promise</p>
        <h2 id="promises-title" data-split>Built for performance. <span class="text-gradient">Backed by commitments.</span></h2>
      </div>
      <dl class="promises__grid">
        {
          promises.map((p, i) => (
            <div class="promises__item" data-reveal style={`--i: ${i}`}>
              <dt class="sr-only">{p.label}</dt>
              <dd class="promises__value">
                <span data-count={p.value} data-suffix={p.suffix}>
                  {p.value}
                  {p.suffix}
                </span>
              </dd>
              <dd class="promises__label" aria-hidden="true">
                {p.label}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .promises {
    position: relative;
    padding-block: var(--section-y);
    background: var(--bg);
  }

  .promises__inner {
    display: grid;
    gap: clamp(40px, 5vw, 72px);
  }

  .promises__intro h2 {
    max-width: 16ch;
  }

  .promises__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid var(--line-strong);
  }

  @media (min-width: 960px) {
    .promises__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .promises__item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 22px clamp(14px, 2vw, 28px) 28px;
    border-bottom: 1px solid var(--line-strong);
  }

  .promises__item:not(:nth-child(2n + 1)) {
    border-left: 1px solid var(--line-strong);
  }

  @media (min-width: 960px) {
    .promises__item {
      border-bottom: 0;
    }

    .promises__item:not(:first-child) {
      border-left: 1px solid var(--line-strong);
    }
  }

  .promises__grid {
    counter-reset: promise;
  }

  .promises__item {
    counter-increment: promise;
  }

  .promises__item::before {
    content: '(' counter(promise, decimal-leading-zero) ')';
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--ink-2);
  }

  .promises__value {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 7.4vw, 6.6rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .promises__label {
    margin: 0;
    max-width: 24ch;
    font-size: 0.98rem;
    color: var(--ink-2);
  }
</style>
