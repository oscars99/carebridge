---
import Icon from '../Icon.astro';
import { aiAdvantages } from '../../data/home';

const messages = [
  { from: 'user', text: 'Hi! Can I get a table for 4 this Friday at 7pm?' },
  { from: 'bot', text: 'Absolutely! Friday at 7:00 PM is available for 4 guests. What name should I put the reservation under?' },
  { from: 'user', text: 'Maria, please.' },
  { from: 'bot', text: 'You’re all set, Maria — table for 4, Friday at 7:00 PM. A confirmation text is on its way!' },
];
---

<section class="section ai theme-dark" aria-labelledby="ai-title">
  <div class="bg-grid" aria-hidden="true"></div>
  <div class="orb orb--violet ai__orb" aria-hidden="true"></div>
  <div class="container split split--60-40">
    <div>
      <div class="section-head" data-reveal>
        <p class="eyebrow">The AI advantage</p>
        <h2 id="ai-title">Human strategy. AI speed. <span class="text-gradient">Real results.</span></h2>
        <p class="lead">
          We use AI the smart way — to research faster, test more ideas and automate busywork — while experienced people make every
          decision that matters. You get agency-level work at a small-business pace and price.
        </p>
      </div>
      <ul class="ai__list" role="list">
        {
          aiAdvantages.map((a, i) => (
            <li class="ai__item" data-reveal style={`--i: ${i}`}>
              <span class="icon-badge icon-badge--sm">
                <Icon name={a.icon} />
              </span>
              <div>
                <h3>{a.title}</h3>
                <p>{a.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <a href="/services/ai-automation/" class="link-arrow mt-4" data-reveal>
        Explore AI automation &amp; chatbots <Icon name="arrow-right" />
      </a>
    </div>

    <figure class="chat" data-chat data-reveal="scale">
      <div class="chat__head">
        <span class="chat__avatar"><Icon name="bot" size={20} strokeWidth={2} /></span>
        <div class="chat__who">
          <strong>Bella’s Bistro · AI host</strong>
          <span><i class="chat__online" aria-hidden="true"></i> Online — replies instantly</span>
        </div>
        <span class="chat__badge">Demo</span>
      </div>
      <div class="chat__body" data-chat-body>
        {
          messages.map((m) => (
            <p class:list={['chat__msg', `chat__msg--${m.from}`]} data-chat-msg>
              <span class="sr-only">{m.from === 'bot' ? 'Assistant:' : 'Customer:'} </span>
              {m.text}
            </p>
          ))
        }
        <p class="chat__msg chat__msg--system" data-chat-msg>
          <Icon name="calendar-check" size={16} strokeWidth={2} /> Reservation saved · Confirmation text sent
        </p>
        <div class="chat__typing" data-chat-typing aria-hidden="true"><span></span><span></span><span></span></div>
      </div>
      <div class="chat__input" aria-hidden="true">
        <span>Type a message…</span>
        <span class="chat__send"><Icon name="send" size={16} strokeWidth={2} /></span>
      </div>
      <figcaption class="sr-only">Example conversation with a website AI assistant booking a restaurant reservation.</figcaption>
    </figure>
  </div>
</section>

<style>
  .ai {
    overflow: hidden;
  }

  .ai__orb {
    width: 520px;
    height: 520px;
    right: -120px;
    top: 10%;
    opacity: 0.35;
    animation: drift 24s var(--ease-in-out) infinite;
  }

  .ai .container {
    position: relative;
  }

  .ai .section-head {
    margin-bottom: 36px;
  }

  .ai__list {
    display: grid;
    gap: 18px;
    padding: 0;
  }

  @media (min-width: 640px) {
    .ai__list {
      grid-template-columns: 1fr 1fr;
      gap: 24px 28px;
    }
  }

  .ai__item {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .ai__item h3 {
    font-size: 1.08rem;
    margin-bottom: 4px;
  }

  .ai__item p {
    font-size: 0.96rem;
    color: var(--on-night-muted);
  }

  /* ---------- Chat demo ---------- */
  .chat {
    position: relative;
    width: 100%;
    max-width: 440px;
    margin-inline: auto;
    border-radius: 28px;
    background: linear-gradient(180deg, rgba(28, 35, 88, 0.85), rgba(11, 16, 48, 0.95));
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow:
      0 60px 120px -50px rgba(124, 92, 255, 0.55),
      0 30px 60px -30px rgba(0, 0, 0, 0.8),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .chat__head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
  }

  .chat__avatar {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 14px;
    color: #fff;
    background: linear-gradient(135deg, #22d3ee, #5b3df5);
    box-shadow: 0 8px 20px -8px rgba(34, 211, 238, 0.7);
  }

  .chat__who {
    display: grid;
    line-height: 1.3;
  }

  .chat__who strong {
    font-family: var(--font-display);
    font-size: 0.98rem;
    color: #fff;
  }

  .chat__who span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    color: var(--on-night-muted);
  }

  .chat__online {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--success-on-dark);
    animation: pulse-ring 2s ease-out infinite;
  }

  .chat__badge {
    margin-left: auto;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--violet-300);
    background: rgba(124, 92, 255, 0.16);
    border: 1px solid rgba(196, 181, 253, 0.2);
  }

  .chat__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 360px;
    padding: 20px 18px;
  }

  .chat__msg {
    max-width: 84%;
    padding: 11px 14px;
    border-radius: 18px;
    font-size: 0.93rem;
    line-height: 1.45;
    transform-origin: bottom left;
  }

  .chat__msg--user {
    align-self: flex-end;
    color: #fff;
    background: var(--grad-cta);
    border-bottom-right-radius: 6px;
    transform-origin: bottom right;
  }

  .chat__msg--bot {
    align-self: flex-start;
    color: var(--on-night);
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom-left-radius: 6px;
  }

  .chat__msg--system {
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    max-width: none;
    padding: 6px 12px;
    font-size: 0.78rem;
    color: var(--success-on-dark);
    background: rgba(74, 222, 128, 0.1);
    border: 1px solid rgba(74, 222, 128, 0.2);
    border-radius: 999px;
    transform-origin: center;
  }

  /* JS-driven playback states */
  .chat__msg.is-hidden {
    display: none;
  }

  .chat__msg.is-in {
    animation: msg-in 0.45s var(--ease-spring) both;
  }

  .chat__typing {
    display: none;
    align-self: flex-start;
    gap: 4px;
    padding: 14px 16px;
    border-radius: 18px;
    border-bottom-left-radius: 6px;
    background: rgba(255, 255, 255, 0.07);
  }

  .chat__typing.is-active {
    display: inline-flex;
  }

  .chat__typing.is-user {
    align-self: flex-end;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 6px;
    background: rgba(91, 61, 245, 0.45);
  }

  .chat__typing span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.7);
    animation: typing 1.2s ease-in-out infinite;
  }

  .chat__typing span:nth-child(2) {
    animation-delay: 0.15s;
  }

  .chat__typing span:nth-child(3) {
    animation-delay: 0.3s;
  }

  .chat__input {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 14px 14px;
    padding: 8px 8px 8px 16px;
    border-radius: 999px;
    font-size: 0.88rem;
    color: rgba(168, 176, 216, 0.7);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .chat__send {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: #fff;
    background: var(--grad-cta);
  }

  @keyframes msg-in {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.92);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes typing {
    0%,
    60%,
    100% {
      transform: translateY(0);
      opacity: 0.5;
    }
    30% {
      transform: translateY(-4px);
      opacity: 1;
    }
  }
</style>
