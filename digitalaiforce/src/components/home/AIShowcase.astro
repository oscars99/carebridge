---
import Icon from '../Icon.astro';
import { aiAdvantages } from '../../data/home';

const messages = [
  { from: 'user', text: 'Hi! Can I get a table for 4 this Friday at 7pm?' },
  { from: 'bot', text: 'Absolutely! Friday at 7:00 PM is available for 4 guests. What name should I put the reservation under?' },
  { from: 'user', text: 'Maria, please.' },
  { from: 'bot', text: 'You’re all set, Maria — table for 4, Friday at 7:00 PM. A confirmation text is on its way!' },
];
---

<section class="section ai theme-dark" aria-labelledby="ai-title">
  <div class="container split split--60-40">
    <div>
      <div class="section-head" data-reveal>
        <p class="eyebrow">The AI advantage</p>
        <h2 id="ai-title" data-split>Human strategy. AI speed. <span class="text-gradient">Real results.</span></h2>
        <p class="lead">
          We use AI the smart way — to research faster, test more ideas and automate busywork — while experienced people make every
          decision that matters. You get agency-level work at a small-business pace and price.
        </p>
      </div>
      <ul class="ai__list" role="list">
        {
          aiAdvantages.map((a, i) => (
            <li class="ai__item" data-reveal style={`--i: ${i}`}>
              <span class="ai__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{a.title}</h3>
                <p>{a.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <a href="/services/ai-automation/" class="link-arrow mt-4" data-reveal>
        Explore AI automation &amp; chatbots <Icon name="arrow-right" />
      </a>
    </div>

    <figure class="chat" data-chat data-reveal="scale">
      <div class="chat__head">
        <span class="chat__avatar"><Icon name="bot" size={20} strokeWidth={2} /></span>
        <div class="chat__who">
          <strong>Bella’s Bistro · AI host</strong>
          <span><i class="chat__online" aria-hidden="true"></i> Online — replies instantly</span>
        </div>
        <span class="chat__badge">Live demo</span>
      </div>
      <div class="chat__body" data-chat-body>
        {
          messages.map((m) => (
            <p class:list={['chat__msg', `chat__msg--${m.from}`]} data-chat-msg>
              <span class="sr-only">{m.from === 'bot' ? 'Assistant:' : 'Customer:'} </span>
              {m.text}
            </p>
          ))
        }
        <p class="chat__msg chat__msg--system" data-chat-msg>
          <Icon name="calendar-check" size={16} strokeWidth={2} /> Reservation saved · Confirmation text sent
        </p>
        <div class="chat__typing" data-chat-typing aria-hidden="true"><span></span><span></span><span></span></div>
      </div>
      <div class="chat__input" aria-hidden="true">
        <span>Type a message…</span>
        <span class="chat__send"><Icon name="send" size={16} strokeWidth={2} /></span>
      </div>
      <figcaption class="sr-only">Example conversation with a website AI assistant booking a restaurant reservation.</figcaption>
    </figure>
  </div>
</section>

<style>
  .ai {
    overflow: hidden;
  }

  .ai .section-head {
    margin-bottom: 44px;
  }

  .ai__list {
    display: grid;
    padding: 0;
    border-top: 1px solid var(--dark-line);
  }

  @media (min-width: 640px) {
    .ai__list {
      grid-template-columns: 1fr 1fr;
      column-gap: 36px;
    }
  }

  .ai__item {
    display: flex;
    gap: 16px;
    align-items: baseline;
    padding-block: 22px;
    border-bottom: 1px solid var(--dark-line);
  }

  .ai__num {
    flex: none;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--ember);
  }

  .ai__item h3 {
    font-size: 1.08rem;
    margin-bottom: 4px;
  }

  .ai__item p {
    font-size: 0.96rem;
    color: var(--text-muted);
  }

  /* ---------- Chat demo ---------- */
  .chat {
    display: flex;
    flex-direction: column;
    max-width: 460px;
    width: 100%;
    margin-inline: auto;
    border-radius: var(--radius-xl);
    overflow: hidden;
    color: var(--ink);
    background: var(--paper);
    box-shadow: 0 50px 100px -40px rgba(0, 0, 0, 0.8);
    rotate: 1.5deg;
  }

  .chat__head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 20px;
    border-bottom: 1px solid var(--line);
  }

  .chat__avatar {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: var(--ink);
    background: var(--ember);
  }

  .chat__who {
    display: grid;
    line-height: 1.3;
  }

  .chat__who strong {
    font-size: 0.95rem;
  }

  .chat__who span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    color: var(--ink-2);
  }

  .chat__online {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--success);
  }

  .chat__badge {
    margin-left: auto;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: 1px solid var(--line-strong);
  }

  .chat__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 360px;
    padding: 20px;
  }

  .chat__msg {
    max-width: 84%;
    padding: 11px 15px;
    border-radius: 18px;
    font-size: 0.94rem;
    line-height: 1.45;
    transition:
      opacity 0.45s ease,
      transform 0.55s var(--ease-out);
  }

  .chat__msg--user {
    align-self: flex-end;
    color: var(--paper);
    background: var(--ink);
    border-bottom-right-radius: 6px;
  }

  .chat__msg--bot {
    align-self: flex-start;
    background: var(--paper-2);
    border-bottom-left-radius: 6px;
  }

  .chat__msg--system {
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--success);
    border: 1px solid rgba(47, 107, 58, 0.3);
    background: rgba(47, 107, 58, 0.06);
  }

  .chat__msg.is-hidden {
    display: none;
  }

  .chat__msg.is-in {
    animation: chat-in 0.55s var(--ease-out) both;
  }

  @keyframes chat-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.96);
    }
  }

  .chat__typing {
    display: none;
    align-self: flex-start;
    gap: 4px;
    padding: 14px 16px;
    border-radius: 18px;
    background: var(--paper-2);
  }

  .chat__typing.is-user {
    align-self: flex-end;
    background: var(--ink);
  }

  .chat__typing.is-active {
    display: inline-flex;
  }

  .chat__typing span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ink-3);
    animation: typing 1.1s ease-in-out infinite;
  }

  .chat__typing.is-user span {
    background: var(--on-dark-2);
  }

  .chat__typing span:nth-child(2) {
    animation-delay: 0.15s;
  }

  .chat__typing span:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes typing {
    0%,
    60%,
    100% {
      transform: none;
      opacity: 0.5;
    }
    30% {
      transform: translateY(-4px);
      opacity: 1;
    }
  }

  .chat__input {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 16px 16px;
    padding: 8px 8px 8px 18px;
    border-radius: 999px;
    font-size: 0.9rem;
    color: var(--ink-2);
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .chat__send {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: var(--ink);
    background: var(--ember);
  }
</style>
