---
/**
 * Infinite, seamless keyword ticker that leans with scroll speed.
 * Content is duplicated once for the loop (the copy is hidden from assistive tech).
 */
interface Props {
  items: string[];
  reverse?: boolean;
  label?: string;
  tone?: 'ember' | 'ink' | 'paper';
  tilt?: boolean;
}

const { items, reverse = false, label = 'Our services', tone = 'ember', tilt = false } = Astro.props;
---

<div
  class:list={['marquee', `marquee--${tone}`, { 'marquee--reverse': reverse, 'marquee--tilt': tilt }]}
  role="region"
  aria-label={label}
  data-velocity
>
  <div class="marquee__skew">
    <div class="marquee__track">
      {
        [0, 1].map((copy) => (
          <ul class="marquee__group" role="list" aria-hidden={copy === 1 ? 'true' : undefined}>
            {items.map((item, i) => (
              <li class:list={['marquee__item', { 'marquee__item--italic': i % 2 === 1 }]}>
                <span>{item}</span>
                <svg class="marquee__star" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M10.6 1h2.8v7.6l5.4-5.4 2 2-5.4 5.4H23v2.8h-7.6l5.4 5.4-2 2-5.4-5.4V23h-2.8v-7.6l-5.4 5.4-2-2 5.4-5.4H1v-2.8h7.6L3.2 5.2l2-2 5.4 5.4z" />
                </svg>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</div>

<style>
  .marquee {
    --mq-bg: var(--ember);
    --mq-fg: var(--ink);
    --mq-star: var(--ink);
    position: relative;
    overflow: hidden;
    padding-block: clamp(14px, 2vw, 22px);
    color: var(--mq-fg);
    background: var(--mq-bg);
  }

  .marquee--ink {
    --mq-bg: var(--ink);
    --mq-fg: var(--on-dark);
    --mq-star: var(--ember);
  }

  .marquee--paper {
    --mq-bg: transparent;
    --mq-fg: var(--heading);
    --mq-star: var(--ember);
    border-block: 1px solid var(--border);
  }

  .marquee--tilt {
    width: 104%;
    margin-left: -2%;
    rotate: -1.6deg;
  }

  .marquee__skew {
    transform: skewX(calc(var(--velocity, 0) * -0.4deg));
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 42s linear infinite;
  }

  .marquee--reverse .marquee__track {
    animation-direction: reverse;
  }

  @media (hover: hover) and (pointer: fine) {
    .marquee:hover .marquee__track {
      animation-play-state: paused;
    }
  }

  .marquee__group {
    display: flex;
    flex: none;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: clamp(22px, 3vw, 40px);
    padding-right: clamp(22px, 3vw, 40px);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.4vw, 3.6rem);
    line-height: 1.1;
    white-space: nowrap;
  }

  .marquee__item--italic {
    font-style: italic;
  }

  .marquee__star {
    width: clamp(18px, 2vw, 28px);
    height: clamp(18px, 2vw, 28px);
    fill: var(--mq-star);
    animation: spin 12s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track,
    .marquee__star {
      animation: none;
    }
  }
</style>
