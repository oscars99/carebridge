---
import Icon from './Icon.astro';
import { websitePlans, monthlyPlans, pricingFootnote, type Plan } from '../data/pricing';

interface Props {
  /** Unique prefix so the component can appear once per page with stable IDs. */
  id?: string;
}

const { id = 'pricing' } = Astro.props;
const groups: { key: string; label: string; plans: Plan[] }[] = [
  { key: 'websites', label: 'Website projects', plans: websitePlans },
  { key: 'monthly', label: 'Monthly growth plans', plans: monthlyPlans },
];
---

<div class="pricing" data-tabs>
  <div class="pricing__tabs-wrap" data-reveal>
  <div class="pricing__tabs" role="tablist" aria-label="Pricing type">
    <span class="pricing__indicator" aria-hidden="true" data-tab-indicator></span>
    {
      groups.map((g, i) => (
        <button
          type="button"
          role="tab"
          id={`${id}-tab-${g.key}`}
          aria-controls={`${id}-panel-${g.key}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          class="pricing__tab"
          data-tab
        >
          {g.label}
        </button>
      ))
    }
  </div>
  </div>

  {
    groups.map((g, gi) => (
      <div
        class="pricing__panel"
        role="tabpanel"
        id={`${id}-panel-${g.key}`}
        aria-labelledby={`${id}-tab-${g.key}`}
        tabindex="0"
        hidden={gi !== 0}
        data-tab-panel
      >
        <div class="pricing__grid">
          {g.plans.map((plan, i) => (
            <article class:list={['plan', { 'plan--featured': plan.featured }]} data-reveal style={`--i: ${i}`}>
              {plan.badge && <span class="plan__badge">{plan.badge}</span>}
              <h3 class="plan__name">{plan.name}</h3>
              <p class="plan__desc">{plan.description}</p>
              <p class="plan__price">
                {plan.prefix && <span class="plan__prefix">{plan.prefix}</span>}
                <span class="plan__amount">{plan.price}</span>
                <span class="plan__period">{plan.period}</span>
              </p>
              <ul class="plan__features" role="list">
                {plan.features.map((f) => (
                  <li>
                    <Icon name="check" size={18} strokeWidth={2} />
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
              <a
                href={`/contact/?plan=${encodeURIComponent(plan.name)}`}
                class:list={['btn btn--block', plan.featured ? 'btn--primary' : 'btn--ghost']}
              >
                {plan.cta} <Icon name="arrow-right" class="icon--move" />
              </a>
            </article>
          ))}
        </div>
        {g.key === 'monthly' && <p class="pricing__note">{pricingFootnote}</p>}
      </div>
    ))
  }
</div>

<style>
  .pricing__tabs-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: clamp(32px, 4vw, 56px);
  }

  .pricing__tabs {
    position: relative;
    display: inline-grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 4px;
    padding: 5px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
  }

  .pricing__indicator {
    position: absolute;
    top: 5px;
    bottom: 5px;
    left: 0;
    width: var(--w, 50%);
    border-radius: 999px;
    background: var(--ink);
    transform: translateX(var(--x, 5px));
    transition:
      transform 0.55s var(--ease-out),
      width 0.55s var(--ease-out);
  }

  .pricing__tab {
    position: relative;
    z-index: 1;
    min-height: 46px;
    padding: 0 clamp(14px, 3vw, 26px);
    border-radius: 999px;
    font-weight: 600;
    font-size: clamp(0.88rem, 1.6vw, 0.98rem);
    color: var(--ink-2);
    white-space: nowrap;
    transition: color 0.3s ease;
  }

  .pricing__tab[aria-selected='true'] {
    color: var(--paper);
  }

  /* No-JS / pre-JS fallback: highlight the selected tab without the sliding pill */
  :global(html:not(.js)) .pricing__tab[aria-selected='true'] {
    background: var(--ink);
  }

  .pricing__panel:focus-visible {
    outline-offset: 8px;
    border-radius: var(--radius-lg);
  }

  .pricing__panel:not([hidden]) {
    animation: panel-in 0.6s var(--ease-out);
  }

  .pricing__grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    align-items: stretch;
  }

  .plan {
    --plan-muted: var(--ink-2);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(26px, 3vw, 36px);
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    transition:
      transform 0.5s var(--ease-out),
      box-shadow 0.5s var(--ease-out);
  }

  .plan--featured {
    --plan-muted: var(--on-dark-2);
    color: var(--on-dark);
    background: var(--ink);
    border-color: var(--ink);
  }

  .plan__badge {
    position: absolute;
    top: 24px;
    right: 24px;
    padding: 5px 12px;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--ember);
  }

  .plan__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 2rem;
    line-height: 1;
    padding-right: 110px;
  }

  .plan--featured .plan__name {
    color: var(--on-dark);
  }

  .plan__desc {
    font-size: 0.96rem;
    color: var(--plan-muted);
    min-height: 3em;
  }

  .plan__price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    padding-block: 18px 6px;
    border-top: 1px solid var(--line);
  }

  .plan--featured .plan__price {
    border-top-color: var(--dark-line);
  }

  .plan__prefix,
  .plan__period {
    font-size: 0.92rem;
    color: var(--plan-muted);
  }

  .plan__amount {
    font-family: var(--font-display);
    font-size: clamp(3rem, 4.6vw, 4rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 0.9;
    color: var(--heading);
    font-variant-numeric: tabular-nums;
  }

  .plan--featured .plan__amount {
    color: var(--on-dark);
  }

  .plan__features {
    display: grid;
    gap: 10px;
    margin: 0 0 10px;
    padding: 0;
    list-style: none;
    font-size: 0.97rem;
  }

  .plan__features li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }

  .plan__features :global(.icon) {
    flex: none;
    margin-top: 2px;
    color: var(--ember-ink);
  }

  .plan--featured .plan__features :global(.icon) {
    color: var(--ember);
  }

  .plan .btn {
    margin-top: auto;
  }

  .plan--featured .btn--primary {
    --btn-bg: var(--ember);
    --btn-fg: var(--ink);
    --btn-hover-bg: var(--paper);
  }

  .pricing__note {
    margin-top: 24px;
    text-align: center;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  @media (hover: hover) and (pointer: fine) {
    .plan:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-lg);
    }
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
