---
import Icon from './Icon.astro';
import { formatDate, postUrl, readingTime, type Post } from '../lib/blog';

interface Props {
  post: Post;
  featured?: boolean;
  index?: number;
  headingLevel?: 'h2' | 'h3';
}

const { post, featured = false, index = 0, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const minutes = readingTime(post.body);
const icons: Record<string, string> = {
  'Web Design': 'monitor-smartphone',
  SEO: 'search-check',
  'AI & Automation': 'bot',
};
const tones: Record<string, string> = {
  'Web Design': 'ink',
  SEO: 'ember',
  'AI & Automation': 'sand',
};
---

<article class:list={['post-card', { 'post-card--featured': featured }]} data-reveal style={`--i: ${index}`}>
  <div class:list={['post-card__art', `post-card__art--${tones[post.data.category] ?? 'sand'}`]} aria-hidden="true">
    <span class="post-card__word">{post.data.category}</span>
    <span class="post-card__icon"><Icon name={icons[post.data.category] ?? 'sparkles'} size={featured ? 30 : 24} strokeWidth={1.5} /></span>
  </div>
  <div class="post-card__body">
    <p class="post-card__meta">
      <span class="post-card__cat">{post.data.category}</span>
      <span aria-hidden="true">·</span>
      <span>{minutes} min read</span>
    </p>
    <Heading class="post-card__title">
      <a href={postUrl(post)} class="stretched-link">{post.data.title}</a>
    </Heading>
    <p class="post-card__desc">{post.data.description}</p>
    <p class="post-card__foot">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      <span class="link-arrow" aria-hidden="true">Read article <Icon name="arrow-right" /></span>
    </p>
  </div>
</article>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .post-card__art {
    --art-bg: #e2dacb;
    --art-fg: var(--ink);
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    aspect-ratio: 4 / 3;
    padding: 22px;
    overflow: hidden;
    border-radius: var(--radius-lg);
    color: var(--art-fg);
    background: var(--art-bg);
  }

  .post-card__art--ink {
    --art-bg: var(--ink);
    --art-fg: var(--on-dark);
  }

  .post-card__art--ember {
    --art-bg: var(--ember);
  }

  .post-card__word {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(2.4rem, 4.4vw, 3.6rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
    transform-origin: 0 100%;
    transition: transform 0.8s var(--ease-out);
  }

  .post-card__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1px solid currentColor;
    transition: transform 0.6s var(--ease-out);
  }

  .post-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 10px;
  }

  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .post-card__cat {
    color: var(--ember-ink);
  }

  .post-card__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.6rem, 2.2vw, 2rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .post-card__title a {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0% 1px no-repeat;
    transition: background-size 0.6s var(--ease-out);
  }

  .post-card__title a:focus-visible {
    outline: none;
  }

  .post-card:has(.stretched-link:focus-visible) {
    outline: 2px solid var(--ember-ink);
    outline-offset: 6px;
    border-radius: var(--radius-lg);
  }

  .post-card__desc {
    font-size: 0.98rem;
    color: var(--ink-2);
  }

  .post-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: 0.88rem;
    color: var(--ink-2);
  }

  .post-card__foot .link-arrow {
    font-size: 0.92rem;
  }

  @media (min-width: 900px) {
    .post-card--featured {
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      gap: clamp(32px, 4vw, 64px);
      align-items: center;
      grid-column: 1 / -1;
    }

    .post-card--featured .post-card__art {
      aspect-ratio: 16 / 11;
      padding: 32px;
    }

    .post-card--featured .post-card__word {
      font-size: clamp(4rem, 8vw, 7.5rem);
    }

    .post-card--featured .post-card__title {
      font-size: clamp(2.4rem, 3.8vw, 3.4rem);
    }

    .post-card--featured .post-card__desc {
      font-size: 1.08rem;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .post-card:hover .post-card__word {
      transform: scale(1.06);
    }

    .post-card:hover .post-card__icon {
      transform: rotate(-12deg);
    }

    .post-card:hover .post-card__title a {
      background-size: 100% 1px;
    }

    .post-card:hover .link-arrow :global(.icon) {
      transform: translateX(4px);
    }
  }
</style>
