---
import Icon from './Icon.astro';
import { formatDate, postUrl, readingTime, type Post } from '../lib/blog';

interface Props {
  post: Post;
  featured?: boolean;
  index?: number;
  headingLevel?: 'h2' | 'h3';
}

const { post, featured = false, index = 0, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const minutes = readingTime(post.body);
const icons: Record<string, string> = {
  'Web Design': 'monitor-smartphone',
  SEO: 'search-check',
  'AI & Automation': 'bot',
};
---

<article class:list={['post-card card spotlight lift', { 'post-card--featured': featured }]} data-reveal style={`--i: ${index}`}>
  <div class="post-card__art" aria-hidden="true">
    <span class="post-card__icon"><Icon name={icons[post.data.category] ?? 'sparkles'} size={featured ? 44 : 32} strokeWidth={1.6} /></span>
    <span class="post-card__orb"></span>
  </div>
  <div class="post-card__body">
    <p class="post-card__meta">
      <span class="post-card__cat">{post.data.category}</span>
      <span aria-hidden="true">·</span>
      <span>{minutes} min read</span>
    </p>
    <Heading class="post-card__title">
      <a href={postUrl(post)} class="stretched-link">{post.data.title}</a>
    </Heading>
    <p class="post-card__desc">{post.data.description}</p>
    <p class="post-card__foot">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      <span class="link-arrow" aria-hidden="true">Read article <Icon name="arrow-right" /></span>
    </p>
  </div>
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }

  .post-card__art {
    position: relative;
    display: grid;
    place-items: center;
    height: 168px;
    overflow: hidden;
    background:
      radial-gradient(80% 120% at 100% 0%, rgba(124, 92, 255, 0.55), transparent 60%),
      radial-gradient(70% 100% at 0% 100%, rgba(34, 211, 238, 0.35), transparent 60%),
      var(--night-900);
  }

  .post-card__art::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 28px 28px;
  }

  .post-card__icon {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    border-radius: 22px;
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    transition: transform 0.6s var(--ease-spring);
  }

  .post-card__orb {
    position: absolute;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(124, 92, 255, 0.7), transparent 70%);
    filter: blur(20px);
    animation: drift 12s var(--ease-in-out) infinite;
  }

  .post-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
  }

  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.85rem;
  }

  .card .post-card__cat {
    font-weight: 600;
    color: var(--violet-600);
  }

  .post-card__title {
    font-size: 1.2rem;
    line-height: 1.3;
  }

  .post-card__title a:focus-visible {
    outline: none;
  }

  .post-card:has(.stretched-link:focus-visible) {
    outline: 2px solid var(--violet-500);
    outline-offset: 3px;
  }

  .post-card__desc {
    font-size: 0.97rem;
  }

  .post-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 12px;
    font-size: 0.88rem;
  }

  .post-card__foot .link-arrow {
    font-size: 0.92rem;
  }

  @media (min-width: 900px) {
    .post-card--featured {
      flex-direction: row;
      grid-column: 1 / -1;
    }

    .post-card--featured .post-card__art {
      flex: 0 0 44%;
      height: auto;
      min-height: 320px;
    }

    .post-card--featured .post-card__icon {
      width: 104px;
      height: 104px;
      border-radius: 28px;
    }

    .post-card--featured .post-card__body {
      justify-content: center;
      padding: clamp(28px, 4vw, 48px);
    }

    .post-card--featured .post-card__title {
      font-size: clamp(1.5rem, 2.4vw, 2rem);
      letter-spacing: -0.025em;
    }

    .post-card--featured .post-card__desc {
      font-size: 1.05rem;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .post-card:hover .post-card__icon {
      transform: scale(1.08) rotate(-6deg);
    }

    .post-card:hover .link-arrow :global(.icon) {
      transform: translateX(4px);
    }
  }
</style>
