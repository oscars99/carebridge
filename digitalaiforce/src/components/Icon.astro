---
/**
 * Inline SVG icon from the Lucide set (https://lucide.dev, ISC license).
 * Rendered at build time — no icon font or client-side JavaScript.
 */
import iconNodes from 'lucide-static/icon-nodes.json';

type IconNode = [string, Record<string, string>][];

interface Props {
  name: string;
  size?: number;
  strokeWidth?: number;
  class?: string;
  /** Accessible label. Omit for decorative icons (the default). */
  label?: string;
}

const { name, size = 24, strokeWidth = 1.75, class: className, label } = Astro.props;
const node = (iconNodes as unknown as Record<string, IconNode>)[name];

if (!node) {
  throw new Error(`Icon "${name}" not found in lucide-static.`);
}

const escapeAttr = (value: string) => value.replace(/&/g, '&amp;').replace(/"/g, '&quot;');
const inner = node
  .map(([tag, attrs]) => {
    const attributes = Object.entries(attrs)
      .map(([key, value]) => `${key}="${escapeAttr(String(value))}"`)
      .join(' ');
    return `<${tag} ${attributes}/>`;
  })
  .join('');
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['icon', className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={inner}
/>
