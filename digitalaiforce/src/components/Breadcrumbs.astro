---
import type { Crumb } from '../lib/schema';

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol role="list">
    {
      crumbs.map((c, i) => (
        <li>
          {i < crumbs.length - 1 ? (
            <a href={c.path}>{c.name}</a>
          ) : (
            <span aria-current="page">{c.name}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .crumbs li + li::before {
    content: '/';
    font-weight: 400;
    opacity: 0.6;
  }

  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    background: linear-gradient(currentColor, currentColor) 0 calc(100% - 6px) / 0% 1px no-repeat;
    transition:
      color var(--dur-fast) ease,
      background-size 0.4s var(--ease-out);
  }

  .crumbs a:hover {
    color: var(--heading);
    background-size: 100% 1px;
  }

  .crumbs [aria-current] {
    color: var(--heading);
  }
</style>
